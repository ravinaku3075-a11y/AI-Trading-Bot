import os
import ast
import glob
import requests

PROJECT_DIR = os.path.dirname(os.path.abspath(__file__))
GROQ_API_KEY = "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"

def analyze_system_architecture():
    """Scans all modules to build dependency graph & architectural stats"""
    py_files = sorted(glob.glob(os.path.join(PROJECT_DIR, "*.py")))
    total_modules = len(py_files)
    
    dependencies = {}
    total_imports = 0

    for file_path in py_files:
        filename = os.path.basename(file_path)
        imports = []
        try:
            with open(file_path, "r", encoding="utf-8") as f:
                tree = ast.parse(f.read())
            
            for node in ast.walk(tree):
                if isinstance(node, ast.Import):
                    for alias in node.names:
                        imports.append(alias.name)
                elif isinstance(node, ast.ImportFrom):
                    if node.module:
                        imports.append(node.module)

            dependencies[filename] = list(set(imports))
            total_imports += len(imports)
        except Exception:
            dependencies[filename] = []

    scalability_score = min(100, max(60, 100 - (total_imports // 15)))

    return {
        "total_modules": total_modules,
        "total_dependencies": total_imports,
        "scalability_score": scalability_score,
        "dependencies": dependencies
    }

def generate_architectural_blueprint(feature_request):
    """Uses Groq AI to design system architecture for new features"""
    url = "https://api.groq.com/openai/v1/chat/completions"
    headers = {
        "Authorization": f"Bearer {GROQ_API_KEY}",
        "Content-Type": "application/json"
    }

    system_prompt = (
        "You are a Chief Software Architect. Design a modular, high-performance system architecture "
        "blueprint for the requested feature in a Python Desktop Assistant. "
        "Include: 1. Core Component Breakdown 2. Data Flow Strategy 3. Required Python Libraries 4. Integration Steps. "
        "Use clean Markdown formatting."
    )

    user_prompt = f"Design Architecture for Feature: {feature_request}"

    try:
        payload = {
            "model": "llama-3.1-8b-instant",
            "messages": [
                {"role": "system", "content": system_prompt},
                {"role": "user", "content": user_prompt}
            ],
            "temperature": 0.3,
            "max_tokens": 500
        }
        res = requests.post(url, json=payload, headers=headers, timeout=12)
        if res.status_code == 200:
            return res.json()['choices'][0]['message']['content'].strip()
    except Exception as e:
        return f"Error generating blueprint: {str(e)}"

    return "### Architectural Blueprint\n- **Component**: Modular Engine\n- **Flow**: Async Worker -> Local Database -> UI Stream\n- **Libraries**: `asyncio`, `pandas`, `sqlite3`"