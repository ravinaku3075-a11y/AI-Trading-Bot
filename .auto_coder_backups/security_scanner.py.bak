import os
import ast
import glob
import re
import requests

PROJECT_DIR = os.path.dirname(os.path.abspath(__file__))
GROQ_API_KEY = "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"

def analyze_security_ast(file_path):
    """Static AST Audit for Code Vulnerabilities"""
    issues = []
    score = 100

    try:
        with open(file_path, "r", encoding="utf-8") as f:
            code = f.read()

        tree = ast.parse(code)

        # 1. Check for exec() or eval() usage
        for node in ast.walk(tree):
            if isinstance(node, ast.Call):
                if isinstance(node.func, ast.Name) and node.func.id in ['eval', 'exec']:
                    issues.append(f"⚠️ High Risk: Dynamic code execution function `{node.func.id}()` used")
                    score -= 25

        # 2. Check for hardcoded credentials via Regex
        secret_patterns = [
            (r'(?i)(password|passwd|secret|private_key)\s*=\s*["\'][^"\']+["\']', "Potential hardcoded secret/password"),
            (r'gsk_[a-zA-Z0-9]{32,}', "Hardcoded Groq API key pattern detected")
        ]
        
        for pattern, msg in secret_patterns:
            if re.search(pattern, code):
                issues.append(f"🔒 Security Alert: {msg}")
                score -= 15

        # 3. Check for SQL String formatting (SQL Injection Risk)
        if re.search(r'(?i)SELECT|INSERT|UPDATE|DELETE', code) and re.search(r'%\s*\(|\.format\(|f["\'].*SELECT', code):
            issues.append("🛡️ Vulnerability Risk: Potential raw string SQL formatting (SQL Injection risk)")
            score -= 20

    except Exception as e:
        issues.append(f"Security AST Warning: {str(e)}")
        score -= 5

    return max(score, 30), issues

def get_groq_security_advice(file_name, code_content):
    """Groq AI Security Audit Analysis"""
    url = "https://api.groq.com/openai/v1/chat/completions"
    headers = {
        "Authorization": f"Bearer {GROQ_API_KEY}",
        "Content-Type": "application/json"
    }

    system_prompt = (
        "You are an expert Cybersecurity & Python Code Auditor. Analyze the provided code for: "
        "1. Hardcoded keys/passwords 2. SQL injection / dynamic execution risks 3. Input validation issues. "
        "Return 3 to 4 actionable, concise bullet points starting with '🛡️ '. "
        "Do NOT return code blocks or text explanations. Only bullet points."
    )

    user_prompt = f"File: {file_name}\n\nCode:\n{code_content[:3000]}"

    try:
        payload = {
            "model": "llama-3.1-8b-instant",
            "messages": [
                {"role": "system", "content": system_prompt},
                {"role": "user", "content": user_prompt}
            ],
            "temperature": 0.2,
            "max_tokens": 200
        }
        res = requests.post(url, json=payload, headers=headers, timeout=10)
        if res.status_code == 200:
            return res.json()['choices'][0]['message']['content'].strip()
    except Exception:
        pass
    return "🛡️ Store API keys in environment variables (.env)\n🛡️ Sanitize dynamic user inputs before database execution\n🛡️ Avoid raw eval/exec calls on untrusted data"

def run_security_scan():
    """Runs read-only security scan across all Python files"""
    py_files = sorted(glob.glob(os.path.join(PROJECT_DIR, "*.py")))
    results = []

    for file_path in py_files:
        filename = os.path.basename(file_path)
        base_score, ast_issues = analyze_security_ast(file_path)

        with open(file_path, "r", encoding="utf-8") as f:
            code_content = f.read()

        ai_advice = get_groq_security_advice(filename, code_content)
        final_score = max(min(base_score, 100), 30)

        results.append({
            "filename": filename,
            "score": final_score,
            "ast_issues": ast_issues,
            "advice": ai_advice
        })

    return results